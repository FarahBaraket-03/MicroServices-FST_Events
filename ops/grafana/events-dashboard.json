{
  "title": "FST Events | Santé, performance et résilience",
  "uid": "fst-events-demo",
  "description": "Supervision du projet Events Microservices pour la démonstration. Les métriques sont collectées en direct par Prometheus.",
  "id": null,
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "tags": [
    "fst-events",
    "microservices",
    "prometheus"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Source qui collecte le job events-microservices.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "type": "link",
      "title": "Cibles Prometheus",
      "url": "http://localhost:9090/targets",
      "targetBlank": true
    },
    {
      "type": "link",
      "title": "Traces Zipkin",
      "url": "http://localhost:9411",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Disponibilité des services",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cibles joignables",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "Instantané Prometheus. 100 % signifie que toutes les cibles configurées ont été collectées avec succès. L’historique des cibles détaille l’état de chaque instance.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * sum(up{job=\"events-microservices\"}) / count(up{job=\"events-microservices\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 0,
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#F46B73",
                "value": null
              },
              {
                "color": "#2FBA8B",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Trafic Gateway · 1 min",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "Requêtes HTTP reçues par la Gateway par seconde, hors Actuator. Les appels Feign des autres services sont comptés séparément.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"api-gateway\"}[1m]))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#64A7FF",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Erreurs Gateway 5xx · 5 min",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "Part des réponses HTTP serveur 5xx sur les cinq dernières minutes, hors Actuator. Un résultat absent signifie qu’aucun trafic mesurable ne permet de calculer le taux.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * ((sum(rate(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"api-gateway\",status=~\"5..\"}[5m]))) or (0 * sum(rate(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"api-gateway\"}[5m])))) / (sum(rate(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"api-gateway\"}[5m])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#2FBA8B",
                "value": null
              },
              {
                "color": "#F2BE5C",
                "value": 1
              },
              {
                "color": "#F46B73",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Latence Gateway p95 · 5 min",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "description": "95 % des requêtes sont estimées sous cette durée. Calcul sur les histogrammes Micrometer des cinq dernières minutes, hors Actuator.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"api-gateway\"}[5m])))) and (sum(rate(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"api-gateway\"}[5m])) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 0,
          "noValue": "—",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#64A7FF",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "state-timeline",
      "title": "État des cibles Prometheus",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 8
      },
      "description": "Une ligne par cible. UP indique que Prometheus a pu lire /actuator/prometheus. Ce signal ne couvre pas toutes les fonctions métier.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "up{job=\"events-microservices\"}",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8695AB",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "#2FBA8B",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "#F46B73",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "alignValue": "center",
        "rowHeight": 0.74,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Trafic, latence et erreurs",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requêtes par service",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "description": "Trafic HTTP en requêtes par seconde, lissé sur une minute. Une même action peut traverser la Gateway et plusieurs services.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=~\"api-gateway|event-service|participant-service|logistics-service\"}[1m]))",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Latence p95 par service",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "description": "Durée estimée pour 95 % des requêtes de chaque service. Les instances d’un même service sont agrégées par leurs histogrammes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=~\"api-gateway|event-service|participant-service|logistics-service\"}[5m])))",
          "legendFormat": "{{application}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Erreurs serveur et limitation du trafic",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "description": "Les 5xx montrent des erreurs serveur visibles à la Gateway. HTTP 429 indique des appels limités par event-service. Les courbes utilisent une fenêtre glissante d’une minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"api-gateway\",status=~\"5..\"}[1m]))",
          "legendFormat": "5xx · Gateway",
          "instant": false,
          "range": true,
          "format": "time_series"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"event-service\",status=\"429\"}[1m]))",
          "legendFormat": "429 · Event",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 52,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "5xx · Gateway"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F46B73"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "429 · Event"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#F2BE5C"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Trafic par instance participant",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "description": "Avec deux instances actives, les deux courbes montrent quelles instances reçoivent du trafic. Vérifier l’alternance requête par requête avec scripts/load-balance.ps1.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"events-microservices\",uri!~\"/actuator(/.*)?\",application=\"participant-service\"}[1m]))",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Résilience de l’Event Service",
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 13,
      "type": "state-timeline",
      "title": "Circuit breakers par dépendance",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 6
      },
      "description": "Fermé : appels autorisés. Ouvert : appels bloqués. Semi-ouvert : quelques appels vérifient la reprise. Une transition plus courte que le pas de collecte peut ne pas être visible.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max by (name, instance) ((resilience4j_circuitbreaker_state{job=\"events-microservices\",application=\"event-service\",state=\"closed\"} == 1) * 1 or (resilience4j_circuitbreaker_state{job=\"events-microservices\",application=\"event-service\",state=\"open\"} == 1) * 2 or (resilience4j_circuitbreaker_state{job=\"events-microservices\",application=\"event-service\",state=\"half_open\"} == 1) * 3 or (resilience4j_circuitbreaker_state{job=\"events-microservices\",application=\"event-service\",state=\"forced_open\"} == 1) * 4 or (resilience4j_circuitbreaker_state{job=\"events-microservices\",application=\"event-service\",state=\"disabled\"} == 1) * 5 or (resilience4j_circuitbreaker_state{job=\"events-microservices\",application=\"event-service\",state=\"metrics_only\"} == 1) * 6) and on (instance) (up{job=\"events-microservices\"} == 1)",
          "legendFormat": "{{name}} · {{instance}}",
          "instant": false,
          "range": true,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8695AB",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Fermé",
                  "color": "#2FBA8B",
                  "index": 0
                },
                "2": {
                  "text": "Ouvert",
                  "color": "#F46B73",
                  "index": 1
                },
                "3": {
                  "text": "Semi-ouvert",
                  "color": "#F2BE5C",
                  "index": 2
                },
                "4": {
                  "text": "Forcé ouvert",
                  "color": "#F46B73",
                  "index": 3
                },
                "5": {
                  "text": "Désactivé",
                  "color": "#8695AB",
                  "index": 4
                },
                "6": {
                  "text": "Métriques seules",
                  "color": "#64A7FF",
                  "index": 5
                }
              }
            }
          ],
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "auto",
        "mergeValues": true,
        "alignValue": "center",
        "rowHeight": 0.74,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 14,
